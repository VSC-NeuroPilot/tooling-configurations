  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.2",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^20.19.25",
    "@typescript/native-preview": "7.0.0-dev.20260225.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "oxlint": "^1.50.0",
    "oxlint-tsgolint": "^0.15.0",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@eslint/js": "^9.39.1",
    "@stylistic/eslint-plugin": "^5.5.0",
