      "import": "./dist/esbuild/index.mjs",
      "require": "./dist/esbuild/index.cjs"
    },
    "./esbuild-plugins": {
      "import": "./dist/esbuild/plugins.mjs",
      "require": "./dist/esbuild/plugins.cjs"
    },
    "./package.json": "./package.json"
